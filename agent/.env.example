# Polymarket autonomous agent — environment template
# Copy to .env and fill in real values:
#   cp .env.example .env && chmod 600 .env

# Required: Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Required: absolute path to the polymarket-skills checkout
POLYMARKET_SKILLS_ROOT=/home/youruser/polymarket-skills

# Model. Default is claude-sonnet-4-6 — strong capability with effective prompt
# caching at this prompt size (~10x cheaper than Opus). Override to
# claude-opus-4-7 for the most capable model, or claude-haiku-4-5 for the cheapest.
CLAUDE_MODEL=claude-sonnet-4-6

# Cycle interval in seconds. 900 = 15 minutes.
AGENT_INTERVAL=900

# Hard ceiling on tool-use turns per cycle.
AGENT_MAX_TURNS=20

# Max tokens per Claude response. 16000 is safe for non-streaming.
AGENT_MAX_TOKENS=16000

# Per-script timeout in seconds.
SCRIPT_TIMEOUT=180

# Hour of day (UTC) when the agent runs daily_review instead of session-start.
DAILY_REVIEW_HOUR_UTC=23

# Python interpreter the scripts use. Leave blank to inherit from the agent's
# own interpreter (recommended when running under systemd from a venv).
# PYTHON_BIN=/home/youruser/.venv/bin/python
