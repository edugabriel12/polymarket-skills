# Polymarket autonomous agent — environment template
# Copy to .env and fill in real values:
#   cp .env.example .env && chmod 600 .env

# Required: Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Required: absolute path to the polymarket-skills checkout
POLYMARKET_SKILLS_ROOT=/home/youruser/polymarket-skills

# Model. Default is claude-sonnet-4-6 — strong capability with effective prompt
# caching at this prompt size (~10x cheaper than Opus). Override to
# claude-opus-4-7 for the most capable model, or claude-haiku-4-5 for the cheapest.
CLAUDE_MODEL=claude-sonnet-4-6

# Cycle interval in seconds. 900 = 15 minutes.
AGENT_INTERVAL=900

# Hard ceiling on tool-use turns per cycle.
AGENT_MAX_TURNS=20

# Max tokens per Claude response. 16000 is safe for non-streaming.
AGENT_MAX_TOKENS=16000

# Per-script timeout in seconds.
SCRIPT_TIMEOUT=180

# Hour of day (UTC) when the agent runs daily_review instead of session-start.
DAILY_REVIEW_HOUR_UTC=23

# Python interpreter the scripts use. Leave blank to inherit from the agent's
# own interpreter (recommended when running under systemd from a venv).
# PYTHON_BIN=/home/youruser/.venv/bin/python

# === AUTONOMOUS LIVE TRADING (opt-in, real money) ===
# Setting POLYMARKET_AUTO_CONFIRM=true is the master switch. With it on, AND
# the live-readiness criteria from CLAUDE.md §4 passing, AND no ~/halt-trading
# file, the agent WILL execute real trades without per-trade human confirmation.
# Leave blank/unset to keep the agent paper-only.
POLYMARKET_AUTO_CONFIRM=

# Burner wallet only — NEVER your main wallet. See polymarket-live-executor/
# references/security.md. Create with `setup_wallet.py --create`.
POLYMARKET_PRIVATE_KEY=

# Required by execute_live.py independently of POLYMARKET_AUTO_CONFIRM.
POLYMARKET_CONFIRM=true

# Hard caps enforced by execute_live.py. Per-trade $5 / daily-loss $50 here.
POLYMARKET_MAX_SIZE=5
POLYMARKET_DAILY_LOSS_LIMIT=50

# Killswitch path. Touch this file to halt all trading within ≤1 cycle:
#   touch ~/halt-trading
# Remove it to resume:
#   rm ~/halt-trading
HALT_FILE=

# Telegram alerts on every live trade (success or failure).
# Create bot via @BotFather, get chat_id from getUpdates after sending /start.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === WEATHER EDGE BOT ===
# OpenWeather API key (free tier 1000 calls/day):
#   https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Visual Crossing API key (free tier 1000 calls/day, judge cross-check):
#   https://www.visualcrossing.com/sign-up
VISUAL_CROSSING_API_KEY=

# NWS user-agent (required by api.weather.gov; free, no key):
#   format: "<app name> <contact email>"
NWS_USER_AGENT=polymarket-weather-edge contact@example.com

# Anthropic model used by the judge (default claude-sonnet-4-6).
# Keeping default minimizes cost; cache hits make repeat calls cheap.
CLAUDE_JUDGE_MODEL=claude-sonnet-4-6

# Daily cap on judge spend (USD). When exceeded, judge skips remaining
# proposals for the rest of the UTC day.
JUDGE_DAILY_BUDGET_USD=5.0

# Judge poll interval in seconds.
JUDGE_POLL_INTERVAL_SEC=120
