[Unit]
Description=Polymarket weather edge judge (Claude API gatekeeper)
Documentation=file:%h/polymarket-skills/polymarket-analyzer/references/weather-edge-strategy.md
After=network-online.target weather-edge-bot.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/polymarket-skills/agent/.env
ExecStart=/usr/bin/env python3 %h/polymarket-skills/polymarket-analyzer/scripts/weather_edge_judge.py
Restart=on-failure
RestartSec=120s
StandardOutput=journal
StandardError=journal
MemoryMax=256M
CPUQuota=25%

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.polymarket-paper

[Install]
WantedBy=default.target
