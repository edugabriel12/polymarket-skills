# Polymarket Sports (the storefront) config. Copy to backend/.env.

# --- Ingest from the brain (wallet-dashboard) ---------------------------------
# Shared bearer token the brain must present to POST /api/copy/ingest. Leave blank
# only for local/dev (then ingest is unauthenticated).
COPY_INGEST_TOKEN=

# --- Telegram delivery --------------------------------------------------------
# BotFather token + chat id. When both are set, each new/upgraded entry is sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Storage ------------------------------------------------------------------
# SPORTS_ENTRIES_DB=
