# Dashboard backend config. Copy to ".env" (same folder, or repo root) and fill in.
# Real environment variables take precedence over this file.

# football-data.org API key -> enables automatic soccer settlement (Resultados tab) AND
# league-baseline calibration (avg goals/game per league, used by the soccer model).
# Free key: https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=

# API-Football (api-sports.io) key -> automatic attack/defense for leagues Club Elo doesn't
# cover (e.g. Brasileirão Série B) + baseline calibration there. Free 100 req/day.
# Key: https://www.api-football.com/  (or via RapidAPI -> use the api-sports.io host)
APIFOOTBALL_KEY=

# Optional: team-ratings CSV for the soccer model (team,elo,att_factor,def_factor).
# Overrides the automatic national-Elo / Club-Elo / API-Football / xG sources.
# SOCCER_RATINGS_CSV=C:\path\to\teams.csv

# Optional: override the prediction DB locations.
# SOCCER_PREDICTIONS_DB=
# TENNIS_PREDICTIONS_DB=
# DASHBOARD_CACHE_DB=

# Optional tennis settings.
# TENNIS_TOUR=atp
# TENNIS_RATINGS_CSV=

# The Odds API key -> live sharp anchor for the soccer/tennis divergence models.
# ODDS_API_KEY=

# Hourly auto-recalc: recompute every sport at the top of each UTC hour and refresh the
# cache. ON by default; set to 0 to disable (the /api/analyses?force=true endpoint still works).
# AUTO_RECALC=1
