# Wallet-dashboard (the "brain") config. Copy to backend/.env — it is auto-loaded at
# startup (real shell env always wins over the file). On Windows, just create backend\.env.

# --- Push to Polymarket Sports (the storefront) -------------------------------
# Where to push entries (Sports backend base URL) + the shared bearer token that the
# Sports /api/copy/ingest endpoint also checks.
SPORTS_INGEST_URL=http://localhost:8000
COPY_INGEST_TOKEN=

# --- Scheduler ----------------------------------------------------------------
# AUTO_BRAIN=1 runs the models at the top of every hour (RECALC_TZ) and polls the
# watched wallets every WATCH_POLL_SEC; both push to Sports. Set 0 to disable.
AUTO_BRAIN=1
WATCH_POLL_SEC=45
RECALC_TZ=America/Sao_Paulo

# --- Model (soccer runs in the brain now) -------------------------------------
# The brain drives suggest_soccer.py via subprocess; it inherits this environment.
# Each key is optional and degrades gracefully:
#   ODDS_API_KEY        -> sharp odds anchor; without it the model is Elo-only and
#                          large edges get capped (see references). Biggest win.
#   APIFOOTBALL_KEY     -> strength model for club leagues Club Elo lacks (e.g. Série B).
#   FOOTBALL_DATA_TOKEN -> results/baseline calibration (track_soccer.py).
# ODDS_API_KEY=
# APIFOOTBALL_KEY=
# FOOTBALL_DATA_TOKEN=
# Optional prediction-store path.
# SOCCER_PREDICTIONS_DB=

# --- Storage ------------------------------------------------------------------
# DASHBOARD_WALLETS_DB=
