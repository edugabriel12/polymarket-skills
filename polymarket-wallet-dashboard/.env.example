# Wallet-dashboard (the "brain") config. Copy to backend/.env (or export in the shell).

# --- Push to Polymarket Sports (the storefront) -------------------------------
# Where to push entries (Sports backend base URL) + the shared bearer token that the
# Sports /api/copy/ingest endpoint also checks.
SPORTS_INGEST_URL=http://localhost:8000
COPY_INGEST_TOKEN=

# --- Scheduler ----------------------------------------------------------------
# AUTO_BRAIN=1 runs the models at the top of every hour (RECALC_TZ) and polls the
# watched wallets every WATCH_POLL_SEC; both push to Sports. Set 0 to disable.
AUTO_BRAIN=1
WATCH_POLL_SEC=45
RECALC_TZ=America/Sao_Paulo

# --- Models (soccer/tennis run in the brain now) ------------------------------
# Optional prediction-store paths + the live sharp anchor key (same as before).
# SOCCER_PREDICTIONS_DB=
# TENNIS_PREDICTIONS_DB=
# TENNIS_TOUR=atp
# ODDS_API_KEY=
# FOOTBALL_DATA_TOKEN=
# APIFOOTBALL_KEY=

# --- Storage ------------------------------------------------------------------
# DASHBOARD_WALLETS_DB=
